#include <mcr/mc_runtime_api.h>
#include <cub/block/block_reduce.cuh>

#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstdlib>


struct ArgmaxResult {
	float value;
	std::uint32_t index;
};


__host__ __device__
inline ArgmaxResult invalid_argmax_result() {
	return ArgmaxResult{
		0.0F,
		UINT32_MAX,
	};
}


__host__ __device__
inline bool is_valid_argmax_result(
	const ArgmaxResult &result
) {
	return result.index != UINT32_MAX;
}


__host__ __device__
inline bool argmax_candidate_is_better(
	const ArgmaxResult &candidate,
	const ArgmaxResult &current
) {
	if (!is_valid_argmax_result(candidate)) {
		return false;
	}

	if (!is_valid_argmax_result(current)) {
		return true;
	}

	const bool candidate_nan =
		isnan(candidate.value);

	const bool current_nan =
		isnan(current.value);

	// NaN wins over non-NaN.
	if (candidate_nan != current_nan) {
		return candidate_nan;
	}

	// Both NaN:
	// smaller index wins.
	if (candidate_nan) {
		return candidate.index < current.index;
	}

	if (candidate.value > current.value) {
		return true;
	}

	if (candidate.value < current.value) {
		return false;
	}

	// Equal numeric values:
	// smaller index wins.
	return candidate.index < current.index;
}


struct ArgmaxReduceOp {
	__host__ __device__
	ArgmaxResult operator()(
		const ArgmaxResult &left,
		const ArgmaxResult &right
	) const {
		if (
			argmax_candidate_is_better(
				right,
				left
			)
		) {
			return right;
		}

		return left;
	}
};


template <unsigned int BLOCK_SIZE>
__global__ void cub_argmax_test_kernel(
	ArgmaxResult *output,
	const float *input,
	std::size_t numel
) {
	using BlockReduce =
		cub::BlockReduce<
			ArgmaxResult,
			BLOCK_SIZE
		>;

	__shared__
	typename BlockReduce::TempStorage
		temp_storage;

	ArgmaxResult local =
		invalid_argmax_result();

	for (
		std::size_t index =
			static_cast<std::size_t>(
				threadIdx.x
			);
		index < numel;
		index += BLOCK_SIZE
	) {
		const ArgmaxResult candidate{
			input[index],
			static_cast<std::uint32_t>(
				index
			),
		};

		if (
			argmax_candidate_is_better(
				candidate,
				local
			)
		) {
			local = candidate;
		}
	}

	const ArgmaxResult result =
		BlockReduce(
			temp_storage
		).Reduce(
			local,
			ArgmaxReduceOp{}
		);

	if (threadIdx.x == 0) {
		*output = result;
	}
}


void check_mc(
	mcError_t status,
	const char *what
) {
	if (status == mcSuccess) {
		return;
	}

	std::fprintf(
		stderr,
		"MACA error at %s: %s\n",
		what,
		mcGetErrorString(status)
	);

	std::exit(1);
}


bool same_float(
	float left,
	float right
) {
	if (
		std::isnan(left)
		&& std::isnan(right)
	) {
		return true;
	}

	return left == right;
}


void run_case(
	const char *name,
	const float *host_input,
	std::size_t numel,
	float expected_value,
	std::uint32_t expected_index
) {
	float *device_input = nullptr;

	ArgmaxResult *device_output =
		nullptr;

	check_mc(
		mcMalloc(
			reinterpret_cast<void **>(
				&device_input
			),
			numel * sizeof(float)
		),
		"mcMalloc input"
	);

	check_mc(
		mcMalloc(
			reinterpret_cast<void **>(
				&device_output
			),
			sizeof(ArgmaxResult)
		),
		"mcMalloc output"
	);

	check_mc(
		mcMemcpy(
			device_input,
			host_input,
			numel * sizeof(float),
			mcMemcpyHostToDevice
		),
		"mcMemcpy H2D"
	);

	cub_argmax_test_kernel<256>
		<<<1, 256>>>(
			device_output,
			device_input,
			numel
		);

	check_mc(
		mcGetLastError(),
		"kernel launch"
	);

	check_mc(
		mcDeviceSynchronize(),
		"mcDeviceSynchronize"
	);

	ArgmaxResult host_output{};

	check_mc(
		mcMemcpy(
			&host_output,
			device_output,
			sizeof(ArgmaxResult),
			mcMemcpyDeviceToHost
		),
		"mcMemcpy D2H"
	);

	const bool value_ok =
		same_float(
			host_output.value,
			expected_value
		);

	const bool index_ok =
		host_output.index
			== expected_index;

	std::printf(
		"%-24s "
		"value=%f "
		"index=%u "
		"expected_index=%u "
		"%s\n",
		name,
		host_output.value,
		host_output.index,
		expected_index,
		(
			value_ok
			&& index_ok
		)
			? "PASS"
			: "FAIL"
	);

	if (
		!value_ok
		|| !index_ok
	) {
		std::exit(2);
	}

	check_mc(
		mcFree(device_input),
		"mcFree input"
	);

	check_mc(
		mcFree(device_output),
		"mcFree output"
	);
}


int main() {
	check_mc(
		mcSetDevice(0),
		"mcSetDevice"
	);

	{
		const float input[] = {
			1.0F,
			4.0F,
			2.0F,
			3.0F,
		};

		run_case(
			"normal",
			input,
			4,
			4.0F,
			1
		);
	}

	{
		const float input[] = {
			1.0F,
			9.0F,
			3.0F,
			9.0F,
		};

		run_case(
			"duplicate_max",
			input,
			4,
			9.0F,
			1
		);
	}

	{
		const float input[] = {
			-9.0F,
			-3.0F,
			-7.0F,
		};

		run_case(
			"negative",
			input,
			3,
			-3.0F,
			1
		);
	}

	{
		const float input[] = {
			1.0F,
			INFINITY,
			100.0F,
		};

		run_case(
			"positive_inf",
			input,
			3,
			INFINITY,
			1
		);
	}

	{
		const float input[] = {
			1.0F,
			NAN,
			100.0F,
		};

		run_case(
			"single_nan",
			input,
			3,
			NAN,
			1
		);
	}

	{
		const float input[] = {
			NAN,
			1.0F,
			NAN,
		};

		run_case(
			"multiple_nan",
			input,
			3,
			NAN,
			0
		);
	}

	{
		const float input[] = {
			1000.0F,
			999.0F,
			NAN,
		};

		run_case(
			"nan_after_max",
			input,
			3,
			NAN,
			2
		);
	}

	{
		float input[4096];

		for (
			std::size_t i = 0;
			i < 4096;
			++i
		) {
			input[i] =
				static_cast<float>(i);
		}

		input[123] =
			100000.0F;

		input[3000] =
			100000.0F;

		run_case(
			"large_duplicate",
			input,
			4096,
			100000.0F,
			123
		);
	}

	std::printf(
		"\nAll CUB Argmax tests passed!\n"
	);

	return 0;
}
