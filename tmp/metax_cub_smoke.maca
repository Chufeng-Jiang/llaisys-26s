#include <cub/block/block_reduce.cuh>

constexpr int BLOCK_SIZE = 256;

__global__ void cub_block_reduce_smoke(
	const float *input,
	float *output
) {
	using BlockReduce =
		cub::BlockReduce<
			float,
			BLOCK_SIZE
		>;

	__shared__
	typename BlockReduce::TempStorage temp_storage;

	const int tid =
		threadIdx.x;

	float value =
		input[tid];

	const float sum =
		BlockReduce(
			temp_storage
		).Sum(
			value
		);

	if (tid == 0) {
		output[0] =
			sum;
	}
}