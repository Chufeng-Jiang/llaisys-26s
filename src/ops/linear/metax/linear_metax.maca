// ============================================================
// Portable bias-broadcast launch policy
// ============================================================

inline constexpr unsigned int
	METAX_LINEAR_BLOCK_SIZE =
		256;

inline constexpr std::size_t
	METAX_LINEAR_MAX_GRID_SIZE =
		65535;


std::size_t get_metax_linear_grid_size(
	std::size_t work_items
) {
	if (work_items == 0) {
		return 0;
	}

	const std::size_t uncapped =
		(
			work_items
			+ static_cast<std::size_t>(
				METAX_LINEAR_BLOCK_SIZE
			)
			- 1
		)
		/ static_cast<std::size_t>(
			METAX_LINEAR_BLOCK_SIZE
		);

	return std::min(
		uncapped,
		METAX_LINEAR_MAX_GRID_SIZE
	);
}



bool should_auto_use_fused_linear(
	llaisysDataType_t type,
	std::size_t row_count,
	const void *bias
) {
	if (bias == nullptr) {
		return false;
	}

	switch (type) {

	case LLAISYS_DTYPE_F16:
	case LLAISYS_DTYPE_BF16:
		// ----------------------------------------------------
		// Measured on MetaX across:
		//
		//     N=4096, K=4096
		//     N=1536, K=1536   (Q projection)
		//     N=256,  K=1536   (K/V projection)
		//
		// FP16/BF16 consistently show:
		//
		//     M=1:
		//         portable wins
		//
		//     M>=2:
		//         fused mcBLASLt bias epilogue wins
		//
		// Therefore row_count=2 is the current robust
		// low-precision crossover.
		// ----------------------------------------------------

		return
			row_count >= 2;

	case LLAISYS_DTYPE_F32:
		// ----------------------------------------------------
		// F32 does not yet admit a robust shape-independent
		// policy.
		//
		// q_proj and 4096x4096 favor fusion, while the
		// narrow kv_proj shape exhibits non-monotonic
		// mcBLASLt performance across M.
		//
		// Keep AUTO conservative until algorithm-selection
		// behavior is characterized.
		// ----------------------------------------------------

		return false;

	default:
		return false;
	}
}

// ============================================================
// Linear implementation policy
//
// LLAISYS_METAX_LINEAR_IMPL
//
// auto:
//     bias != nullptr
//         -> try mcBLASLt fused bias
//         -> fallback to portable if unsupported
//
//     bias == nullptr
//         -> portable mcblasGemmEx
//
// portable:
//     shared bias broadcast
//     + mcblasGemmEx
//
// fused:
//     bias != nullptr
//         -> require mcBLASLt fused bias
//
//     bias == nullptr
//         -> portable mcblasGemmEx
//
// Production default:
//     auto
// ============================================================

enum class MetaXLinearImpl {
	AUTO,
	PORTABLE,
	FUSED,
};


MetaXLinearImpl get_metax_linear_impl() {
	static const MetaXLinearImpl impl =
		[]() {
			const char *value =
				std::getenv(
					"LLAISYS_METAX_LINEAR_IMPL"
				);

			if (
				value == nullptr
				|| std::strcmp(
					value,
					"auto"
				) == 0
			) {
				return
					MetaXLinearImpl::AUTO;
			}

			if (
				std::strcmp(
					value,
					"portable"
				) == 0
			) {
				return
					MetaXLinearImpl::PORTABLE;
			}

			if (
				std::strcmp(
					value,
					"fused"
				) == 0
			) {
				return
					MetaXLinearImpl::FUSED;
			}

			throw std::invalid_argument(
				"LLAISYS_METAX_LINEAR_IMPL "
				"must be auto, portable, or fused."
			);
		}();

	return impl;
}


// ============================================================
// mcBLAS / mcBLASLt error helpers
// ============================================================

bool mcblas_status_success(
	mcblasStatus_t status
) {
	return
		status
		== MCBLAS_STATUS_SUCCESS;
}


bool mcblas_status_not_supported(
	mcblasStatus_t status
) {
	return
		status
		== MCBLAS_STATUS_NOT_SUPPORTED;
}


void check_mcblas(
	mcblasStatus_t status,
	const char *operation
) {
	if (
		mcblas_status_success(
			status
		)
	) {
		return;
	}

	const char *status_name =
		mcblasGetStatusName(
			status
		);

	const char *status_string =
		mcblasGetStatusString(
			status
		);

	throw std::runtime_error(
		std::string("Linear: mcBLAS failure in ")
		+ operation
		+ ": "
		+ (
			status_name != nullptr
				? status_name
				: "unknown-status"
		)
		+ " ("
		+ (
			status_string != nullptr
				? status_string
				: "no-status-description"
		)
		+ ")"
	);
}


// ============================================================
// mcBLAS handle resource
// ============================================================

class MetaXLinearBlasHandle {
public:

	MetaXLinearBlasHandle() = default;

	MetaXLinearBlasHandle(
		const MetaXLinearBlasHandle &
	) = delete;

	MetaXLinearBlasHandle &operator=(
		const MetaXLinearBlasHandle &
	) = delete;

	~MetaXLinearBlasHandle() {
		release();
	}


	mcblasHandle_t get(
		int device_id,
		mcStream_t stream
	) {
		CHECK_ARGUMENT(
			device_id >= 0,
			"Linear: MetaX device id must be non-negative."
		);

		if (
			_handle != nullptr
			&& _device_id != device_id
		) {
			release();
		}

		if (_handle == nullptr) {
			MC_CHECK(
				mcSetDevice(
					device_id
				)
			);

			check_mcblas(
				mcblasCreate(
					&_handle
				),
				"mcblasCreate"
			);

			_device_id =
				device_id;
		}

		check_mcblas(
			mcblasSetStream(
				_handle,
				stream
			),
			"mcblasSetStream"
		);

		return _handle;
	}


private:

	void release() noexcept {
		if (_handle == nullptr) {
			_device_id =
				-1;

			return;
		}

		if (_device_id >= 0) {
			(void)mcSetDevice(
				_device_id
			);
		}

		(void)mcblasDestroy(
			_handle
		);

		_handle =
			nullptr;

		_device_id =
			-1;
	}


private:

	int _device_id{
		-1
	};

	mcblasHandle_t _handle{
		nullptr
	};
};


thread_local MetaXLinearBlasHandle
	METAX_LINEAR_BLAS_HANDLE;


// ============================================================
// mcBLASLt RAII descriptors
// ============================================================

class LtMatmulDesc {
public:

	LtMatmulDesc(
		mcblasComputeType_t compute_type,
		macaDataType scale_type
	) {
		check_mcblas(
			mcblasLtMatmulDescCreate(
				&_value,
				compute_type,
				scale_type
			),
			"mcblasLtMatmulDescCreate"
		);
	}

	LtMatmulDesc(
		const LtMatmulDesc &
	) = delete;

	LtMatmulDesc &operator=(
		const LtMatmulDesc &
	) = delete;

	~LtMatmulDesc() {
		if (_value != nullptr) {
			(void)mcblasLtMatmulDescDestroy(
				_value
			);
		}
	}

	mcblasLtMatmulDesc_t get() const {
		return _value;
	}


private:

	mcblasLtMatmulDesc_t _value{
		nullptr
	};
};


class LtMatrixLayout {
public:

	LtMatrixLayout(
		macaDataType type,
		std::uint64_t rows,
		std::uint64_t cols,
		std::int64_t leading_dimension
