		check_mcblas(
			mcblasLtMatrixLayoutCreate(
				&_value,
				type,
				rows,
				cols,
				leading_dimension
			),
			"mcblasLtMatrixLayoutCreate"
		);
	}

	LtMatrixLayout(
		const LtMatrixLayout &
	) = delete;

	LtMatrixLayout &operator=(
		const LtMatrixLayout &
	) = delete;

	~LtMatrixLayout() {
		if (_value != nullptr) {
			(void)mcblasLtMatrixLayoutDestroy(
				_value
			);
		}
	}

	mcblasLtMatrixLayout_t get() const {
		return _value;
	}


private:

	mcblasLtMatrixLayout_t _value{
		nullptr
	};
};


class LtPreference {
public:

	LtPreference() {
		check_mcblas(
			mcblasLtMatmulPreferenceCreate(
				&_value
			),
			"mcblasLtMatmulPreferenceCreate"
		);
	}

	LtPreference(
		const LtPreference &
