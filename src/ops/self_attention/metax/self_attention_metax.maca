#include "self_attention_metax.hpp"

#include "../../../device/metax/metax_common.hpp"
#include "../../../device/metax/metax_dtype.hpp"
#include "../../../utils.hpp"
#include "../cuda_compat/self_attention_cuda_compat.cuh"

#include <mcr/mc_runtime_api.h>

#include <algorithm>
#include <cmath>
#include <cstddef>
#include <limits>

namespace {

namespace cuda_compat =
	llaisys::ops::cuda_compat;

using llaisys::device::metax::dispatch_metax_dtype;
using llaisys::utils::checked_product;


// ============================================================
// MetaX portability-baseline launch policy
// ============================================================
//
// Keep this deliberately simple for the first port:
//
//     block = 256
//
//     grid = min(seqlen * nhead, 65535)
//
// The shared CUDA-compatible kernel itself contains no:
//
//     __shfl_*
//     warp-size assumption
//     vendor attention library
//
// so the first MetaX port only needs to supply launch/runtime
// policy.
// ============================================================

inline constexpr unsigned int
	METAX_SELF_ATTENTION_BLOCK_SIZE =
		256;

inline constexpr std::size_t
	METAX_SELF_ATTENTION_MAX_GRID_SIZE =
		65535;


std::size_t get_metax_self_attention_grid_size(
	std::size_t task_count
) {
	if (task_count == 0) {
		return 0;
	}

	return std::min(
		task_count,
		METAX_SELF_ATTENTION_MAX_GRID_SIZE
	);
}


// ============================================================
// Shared CUDA-compatible baseline launcher
// ============================================================

template <typename T>
void launch_metax_cuda_compat_baseline(
	T *attn_val,
	const T *q,
	const T *k,
	const T *v,
	float scale,
	std::size_t seqlen,
	std::size_t nhead,
	std::size_t dv,
	std::size_t total_len,
	std::size_t nkvhead,
	std::size_t d,
	mcStream_t stream
) {
	const std::size_t task_count =
		checked_product(
			seqlen,
			nhead,
			"SelfAttention: task count overflows size_t."
		);

	if (task_count == 0) {
		return;
	}

	// ========================================================
	// Dynamic shared-memory requirement
	// ========================================================
	//
	// The shared kernel uses:
	//
	//     shared_q[d]
	//     shared_output[dv]
	//     shared_reduction[block_size]
	//     shared_state[4]
	//
	// all in FP32.
	//
	// For the target Qwen2 head size:
	//
	//     d  = 128
	//     dv = 128
	//
	// this is:
	//
	//     (128 + 128 + 256 + 4) * 4
	//     = 2064 bytes
	//
	// so the initial production-model target is far below
	// ordinary per-block shared-memory limits.
	//
	// We intentionally do not invent a MetaX device-property
	// API in this first port. If a future shape exceeds the
	// hardware limit, the launch error remains visible through
	// mcGetLastError() and can then motivate a capability query
	// or alternate kernel.
	// ========================================================

	CHECK_ARGUMENT(
		d
			<= std::numeric_limits<
				std::size_t
			>::max()
				- dv,
		"SelfAttention: shared-memory element count overflows size_t."
	);

	const std::size_t q_output_elements =
		d + dv;

	CHECK_ARGUMENT(
		static_cast<std::size_t>(
			METAX_SELF_ATTENTION_BLOCK_SIZE
		)
			<= std::numeric_limits<
				std::size_t
			>::max()
				- q_output_elements
				- 4,
		"SelfAttention: shared-memory element count overflows size_t."
	);

	const std::size_t shared_elements =
		q_output_elements
		+ static_cast<std::size_t>(
			METAX_SELF_ATTENTION_BLOCK_SIZE
		)
		+ 4;

	CHECK_ARGUMENT(
		shared_elements
			<= std::numeric_limits<
				std::size_t
			>::max()
				/ sizeof(float),
		"SelfAttention: shared-memory byte count overflows size_t."
	);

	const std::size_t shared_memory_bytes =
		shared_elements
		* sizeof(float);

	// ========================================================
	// Grid
	// ========================================================

	const std::size_t grid_size =
		get_metax_self_attention_grid_size(
			task_count
		);

	CHECK_ARGUMENT(
		grid_size > 0,
		"SelfAttention: MetaX grid size must be positive."
	);

	// ========================================================
	// Shared algorithm
	// ========================================================

	cuda_compat::
		launch_self_attention_portable<T>(
			attn_val,
			q,
			k,
			v,
			scale,
			seqlen,
			nhead,
			dv,
			total_len,
			nkvhead,
			d,
			METAX_SELF_ATTENTION_BLOCK_SIZE,
			grid_size,
			shared_memory_bytes,
			stream
		);

	MC_CHECK(
		mcGetLastError()
	);
}

} // namespace


namespace llaisys::ops::metax {

void self_attention(
	std::byte *attn_val,
	const std::byte *q,
	const std::byte *k,
	const std::byte *v,
	float scale,
	llaisysDataType_t type,
	std::size_t seqlen,
	std::size_t nhead,
	std::size_t dv,
	std::size_t total_len,
	std::size_t nkvhead,
	std::size_t d,
	llaisysStream_t stream
) {
	// ========================================================
	// Backend-level contract checks
	// ========================================================
	//
	// The generic operator already validates tensor shape,
	// dtype, device, and contiguity. These checks remain here
	// because the backend is also a contract boundary and may
	// be called from future native paths.
	// ========================================================

	CHECK_ARGUMENT(
		nhead > 0,
		"SelfAttention: query head count must be greater than zero."
	);

	CHECK_ARGUMENT(
		nkvhead > 0,
		"SelfAttention: KV head count must be greater than zero."
	);

	CHECK_ARGUMENT(
		nhead % nkvhead == 0,
		"SelfAttention: query head count must be a multiple of KV head count."
	);

	CHECK_ARGUMENT(
		total_len >= seqlen,
		"SelfAttention: total KV length must not be smaller than query length."
	);

	CHECK_ARGUMENT(
		d > 0,
		"SelfAttention: query/key head dimension must be greater than zero."
	);

	CHECK_ARGUMENT(
		dv > 0,
		"SelfAttention: value head dimension must be greater than zero."
	);

	CHECK_ARGUMENT(
		std::isfinite(
			scale
		),
		"SelfAttention: scale must be finite."
	);

	// ========================================================
	// Pointer-size contracts
	// ========================================================

	const std::size_t output_elements =
		checked_product(
			checked_product(
				seqlen,
				nhead,
				"SelfAttention: output vector count overflows size_t."
			),
			dv,
			"SelfAttention: output element count overflows size_t."
		);

	const std::size_t query_elements =
		checked_product(
			checked_product(
				seqlen,
				nhead,
				"SelfAttention: query vector count overflows size_t."
			),
			d,
			"SelfAttention: query element count overflows size_t."
		);

	const std::size_t key_elements =
		checked_product(
			checked_product(
				total_len,
				nkvhead,
				"SelfAttention: key vector count overflows size_t."
			),
			d,
			"SelfAttention: key element count overflows size_t."
		);

	const std::size_t value_elements =
		checked_product(
			checked_product(
				total_len,
				nkvhead,
				"SelfAttention: value vector count overflows size_t."
			),
			dv,
			"SelfAttention: value element count overflows size_t."
		);

	CHECK_ARGUMENT(
		output_elements == 0
			|| attn_val != nullptr,
		"SelfAttention: output pointer must not be null."
	);

	CHECK_ARGUMENT(
		query_elements == 0
			|| q != nullptr,
		"SelfAttention: query pointer must not be null."
	);

	CHECK_ARGUMENT(
		key_elements == 0
			|| k != nullptr,
		"SelfAttention: key pointer must not be null."
	);

	CHECK_ARGUMENT(
		value_elements == 0
			|| v != nullptr,
		"SelfAttention: value pointer must not be null."
	);

	if (output_elements == 0) {
		return;
	}

	const mcStream_t mc_stream =
		reinterpret_cast<mcStream_t>(
			stream
		);

	// ========================================================
	// DType dispatch
	// ========================================================

	return dispatch_metax_dtype(
		type,
		[&](auto tag) {
			using T =
				typename decltype(
					tag
				)::type;

			return launch_metax_cuda_compat_baseline<T>(
				reinterpret_cast<T *>(
					attn_val
				),
				reinterpret_cast<
					const T *
				>(
					q
				),
				reinterpret_cast<
					const T *
				>(
					k
				),
				reinterpret_cast<
					const T *
				>(
					v
				),
				scale,
				seqlen,
				nhead,
				dv,
				total_len,
				nkvhead,
				d,
				mc_stream
			);
		}
	);
}

} // namespace llaisys::ops::metax
