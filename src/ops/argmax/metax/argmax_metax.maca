namespace {

namespace cuda_compat = llaisys::ops::cuda_compat;

namespace metax_detail = llaisys::ops::metax::detail;

using cuda_compat::ArgmaxResult;

using llaisys::device::metax::dispatch_metax_dtype;

// ============================================================
// Execution implementation
// ============================================================

enum class MetaXArgmaxImpl {
    AUTO,
    PORTABLE,
    MULTIBLOCK,
};

// ============================================================
// Multi-block reduction primitive
// ============================================================

enum class MetaXArgmaxReduction {
    TREE,
    CUB,
    SHUFFLE,
};

// ============================================================
// Cross-block merge mechanism
// ============================================================

enum class MetaXArgmaxMerge {
    STAGE2,
    ATOMIC,
};

// ============================================================
// Defaults
// ============================================================

inline constexpr unsigned int METAX_ARGMAX_DEFAULT_BLOCK_SIZE = 256;

inline constexpr unsigned int METAX_ARGMAX_DEFAULT_MAX_BLOCKS = 256;

// ============================================================
// Measured MetaX AUTO threshold
// ============================================================
//
// Final implementation:
//
//     portable single-block
//
// vs
//
//     two-stage multiblock
//     + CUB BlockReduce<ArgmaxResult>
//
// Six balanced rounds.
//
// Observed:
//
//     4096:
//         portable remains faster
//
//     5120:
//         multiblock + CUB begins to win,
//         but only by approximately 2.4-4.6%
//
//     6144:
//         multiblock + CUB wins by approximately
//         8.4-10.5% across FP32 / FP16 / BF16
//
// Therefore:
//
//     raw crossover:
//         5120
//
//     robust production crossover:
//         6144
//
// ============================================================
inline constexpr std::size_t METAX_ARGMAX_DEFAULT_MULTIBLOCK_THRESHOLD = 6144;

// ============================================================
// Name helpers
// ============================================================

const char *metax_argmax_impl_name(MetaXArgmaxImpl impl) {
    switch (impl) {
    case MetaXArgmaxImpl::AUTO:
        return "auto";

    case MetaXArgmaxImpl::PORTABLE:
        return "portable";

    case MetaXArgmaxImpl::MULTIBLOCK:
        return "multiblock";
    }

    return "unknown";
}

const char *metax_argmax_reduction_name(MetaXArgmaxReduction reduction) {
    switch (reduction) {
    case MetaXArgmaxReduction::TREE:
        return "tree";

    case MetaXArgmaxReduction::CUB:
        return "cub";

    case MetaXArgmaxReduction::SHUFFLE:
        return "shuffle";
    }

    return "unknown";
}

const char *metax_argmax_merge_name(MetaXArgmaxMerge merge) {
    switch (merge) {
    case MetaXArgmaxMerge::STAGE2:
        return "stage2";

    case MetaXArgmaxMerge::ATOMIC:
        return "atomic";
    }

    return "unknown";
}

// ============================================================
// Implementation configuration
//
// LLAISYS_METAX_ARGMAX_IMPL
//
//     auto
//     portable
//     multiblock
//
// Default:
//
//     auto
//
// ============================================================

MetaXArgmaxImpl get_metax_argmax_impl() {
    const char *value = std::getenv("LLAISYS_METAX_ARGMAX_IMPL");

    if (value == nullptr || std::strcmp(value, "auto") == 0) { return MetaXArgmaxImpl::AUTO; }

    if (std::strcmp(value, "portable") == 0) { return MetaXArgmaxImpl::PORTABLE; }

    if (std::strcmp(value, "multiblock") == 0) { return MetaXArgmaxImpl::MULTIBLOCK; }

    throw std::invalid_argument(
        "LLAISYS_METAX_ARGMAX_IMPL "
        "must be auto, portable, or multiblock.");
}

// ============================================================
// Reduction configuration
//
// LLAISYS_METAX_ARGMAX_REDUCTION
//
//     cub
//     tree
//
// Default:
//
//     cub
//
// Six-round direct Tree-vs-CUB measurements showed that CUB
// consistently reduced latency across all tested multi-block
// workloads and FP32 / FP16 / BF16.
//
// Tree remains available for ablation and fallback testing.
// ============================================================

MetaXArgmaxReduction get_metax_argmax_reduction() {
    const char *value = std::getenv("LLAISYS_METAX_ARGMAX_REDUCTION");

    if (value == nullptr || std::strcmp(value, "cub") == 0) { return MetaXArgmaxReduction::CUB; }

    if (std::strcmp(value, "tree") == 0) { return MetaXArgmaxReduction::TREE; }

    if (std::strcmp(value, "shuffle") == 0) { return MetaXArgmaxReduction::SHUFFLE; }

    throw std::invalid_argument(
        "LLAISYS_METAX_ARGMAX_REDUCTION "
        "must be tree, cub, or shuffle.");
}

// ============================================================
// Cross-block merge configuration
//
// LLAISYS_METAX_ARGMAX_MERGE
//
//     stage2
//     atomic
//
// Default:
//
//     stage2
//
// Atomic is currently an experimental NVIDIA-structure-aligned
// path and requires reduction=shuffle.
// ============================================================

MetaXArgmaxMerge get_metax_argmax_merge() {
    const char *value = std::getenv("LLAISYS_METAX_ARGMAX_MERGE");

    if (value == nullptr || std::strcmp(value, "stage2") == 0) { return MetaXArgmaxMerge::STAGE2; }

    if (std::strcmp(value, "atomic") == 0) { return MetaXArgmaxMerge::ATOMIC; }

    throw std::invalid_argument(
        "LLAISYS_METAX_ARGMAX_MERGE "
        "must be stage2 or atomic.");
}

// ============================================================
// Multi-block threshold
//
// Experimental override:
//
// LLAISYS_METAX_ARGMAX_MULTIBLOCK_THRESHOLD
//
// ============================================================

std::size_t get_metax_argmax_multiblock_threshold() {
    const char *value = std::getenv("LLAISYS_METAX_ARGMAX_MULTIBLOCK_THRESHOLD");

    if (value == nullptr) { return METAX_ARGMAX_DEFAULT_MULTIBLOCK_THRESHOLD; }

    char *end = nullptr;

    const unsigned long long parsed = std::strtoull(value, &end, 10);

    if (end == value || *end != '\0' || parsed == 0
        || parsed > static_cast<unsigned long long>(std::numeric_limits<std::uint32_t>::max())) {
        throw std::invalid_argument(
            "LLAISYS_METAX_ARGMAX_MULTIBLOCK_THRESHOLD "
            "must be between 1 and UINT32_MAX.");
    }

    return static_cast<std::size_t>(parsed);
}

// ============================================================
// AUTO execution-policy selector
// ============================================================

MetaXArgmaxImpl select_metax_argmax_impl(MetaXArgmaxImpl configured_impl, std::size_t numel) {
    if (configured_impl != MetaXArgmaxImpl::AUTO) { return configured_impl; }

    const std::size_t threshold = get_metax_argmax_multiblock_threshold();

    if (numel < threshold) { return MetaXArgmaxImpl::PORTABLE; }

    return MetaXArgmaxImpl::MULTIBLOCK;
}

// ============================================================
// Block size
//
// LLAISYS_METAX_ARGMAX_BLOCK_SIZE
//
//     64
//     128
//     256
//
// Default = 256
//
// ============================================================

unsigned int get_metax_argmax_block_size() {
    const char *value = std::getenv("LLAISYS_METAX_ARGMAX_BLOCK_SIZE");

    if (value == nullptr) { return METAX_ARGMAX_DEFAULT_BLOCK_SIZE; }

    const int block_size = std::atoi(value);

    if (block_size != 64 && block_size != 128 && block_size != 256) {
        throw std::invalid_argument(
            "LLAISYS_METAX_ARGMAX_BLOCK_SIZE "
            "must be 64, 128, or 256.");
    }

    return static_cast<unsigned int>(block_size);
}

// ============================================================
// Maximum Stage-1 grid size
//
// LLAISYS_METAX_ARGMAX_MAX_BLOCKS
//
// Default = 256
//
// ============================================================

unsigned int get_metax_argmax_max_blocks() {
    const char *value = std::getenv("LLAISYS_METAX_ARGMAX_MAX_BLOCKS");

    if (value == nullptr) { return METAX_ARGMAX_DEFAULT_MAX_BLOCKS; }

    char *end = nullptr;

    const unsigned long parsed = std::strtoul(value, &end, 10);

    if (end == value || *end != '\0' || parsed == 0 || parsed > 4096) {
        throw std::invalid_argument(
            "LLAISYS_METAX_ARGMAX_MAX_BLOCKS "
            "must be between 1 and 4096.");
    }

    return static_cast<unsigned int>(parsed);
}

// ============================================================
// Grid policy
// ============================================================

unsigned int get_metax_argmax_grid_size(std::size_t numel, unsigned int block_size) {
    const std::size_t required_blocks
        = (numel + static_cast<std::size_t>(block_size) - 1) / static_cast<std::size_t>(block_size);

    const std::size_t max_blocks = static_cast<std::size_t>(get_metax_argmax_max_blocks());

    const std::size_t grid_size = std::min(required_blocks, max_blocks);

    return static_cast<unsigned int>(std::max<std::size_t>(grid_size, 1));
}

// ============================================================
// Debug
// ============================================================

bool metax_argmax_debug_enabled() {
    const char *value = std::getenv("LLAISYS_METAX_ARGMAX_DEBUG");

    return (value != nullptr && std::strcmp(value, "0") != 0);
}

// ============================================================
// Reusable partial-result workspace
// ============================================================

class MetaXArgmaxWorkspace final {
public:
    MetaXArgmaxWorkspace() = default;

    ~MetaXArgmaxWorkspace() noexcept { release(); }

    MetaXArgmaxWorkspace(const MetaXArgmaxWorkspace &) = delete;

    MetaXArgmaxWorkspace &operator=(const MetaXArgmaxWorkspace &) = delete;

    MetaXArgmaxWorkspace(MetaXArgmaxWorkspace &&) = delete;

    MetaXArgmaxWorkspace &operator=(MetaXArgmaxWorkspace &&) = delete;

    ArgmaxResult *get(int device_id, std::size_t required_count) {
        CHECK_ARGUMENT(device_id >= 0, "Argmax: invalid MetaX device id.");

        CHECK_ARGUMENT(
            required_count > 0,
            "Argmax: workspace count "
            "must be greater than zero.");

        // ----------------------------------------------------
        // Device changed.
        // ----------------------------------------------------

        if (_device_id >= 0 && _device_id != device_id) {
            release();

            MC_CHECK(mcSetDevice(device_id));
        }

        if (_device_id < 0) { _device_id = device_id; }

        // ----------------------------------------------------
        // Existing allocation is large enough.
        // ----------------------------------------------------

        if (_pointer != nullptr && _capacity >= required_count) { return _pointer; }

        // ----------------------------------------------------
        // Grow workspace.
        // ----------------------------------------------------

        if (_pointer != nullptr) {
            MC_CHECK(mcFree(_pointer));

            _pointer = nullptr;

            _capacity = 0;
        }

        MC_CHECK(
            mcMalloc(reinterpret_cast<void **>(&_pointer), required_count * sizeof(ArgmaxResult)));

        _capacity = required_count;

        return _pointer;
    }

private:
    void release() noexcept {
        if (_pointer == nullptr) {
            _capacity = 0;

            _device_id = -1;

            return;
        }

        if (_device_id >= 0) { (void)mcSetDevice(_device_id); }

        (void)mcFree(_pointer);

        _pointer = nullptr;

        _capacity = 0;

        _device_id = -1;
    }

private:
    int _device_id{-1};

    ArgmaxResult *_pointer{nullptr};

    std::size_t _capacity{0};
};

thread_local MetaXArgmaxWorkspace METAX_ARGMAX_WORKSPACE;

// ============================================================
// Reusable packed atomic workspace
// ============================================================

class MetaXArgmaxAtomicWorkspace final {
public:
    MetaXArgmaxAtomicWorkspace() = default;

    ~MetaXArgmaxAtomicWorkspace() noexcept { release(); }

    MetaXArgmaxAtomicWorkspace(const MetaXArgmaxAtomicWorkspace &) = delete;

    MetaXArgmaxAtomicWorkspace &operator=(const MetaXArgmaxAtomicWorkspace &) = delete;

    unsigned long long *get(int device_id) {
        CHECK_ARGUMENT(device_id >= 0, "Argmax: invalid MetaX device id.");

        if (_device_id >= 0 && _device_id != device_id) {
            release();

            MC_CHECK(mcSetDevice(device_id));
        }

        if (_device_id < 0) { _device_id = device_id; }

        if (_pointer != nullptr) { return _pointer; }

        MC_CHECK(mcMalloc(reinterpret_cast<void **>(&_pointer), sizeof(unsigned long long)));

        return _pointer;
    }

private:
    void release() noexcept {
        if (_pointer == nullptr) {
            _device_id = -1;

            return;
        }

        if (_device_id >= 0) { (void)mcSetDevice(_device_id); }

        (void)mcFree(_pointer);

        _pointer = nullptr;

        _device_id = -1;
    }

private:
    int _device_id{-1};

    unsigned long long *_pointer{nullptr};
};

thread_local MetaXArgmaxAtomicWorkspace METAX_ARGMAX_ATOMIC_WORKSPACE;

// ============================================================
// Portable single-block implementation
// ============================================================

template <typename T>
void launch_metax_argmax_portable(
    std::int64_t *max_idx,
    T *max_val,
    const T *vals,
    std::size_t numel,
    unsigned int block_size,
    mcStream_t stream) {
    cuda_compat::launch_argmax_portable<T>(max_idx, max_val, vals, numel, block_size, stream);

    MC_CHECK(mcGetLastError());
}

// ============================================================
// Multi-block implementation
// ============================================================
//
// Same:
//
//     input scanning
//     grid policy
//     block size
//     workspace
//     comparator
//     output contract
//
// Variable:
//
//     tree vs CUB vs Shuffle64 block reduction
//
// ============================================================

template <typename T>
void launch_metax_argmax_multiblock(
    std::int64_t *max_idx,
    T *max_val,
    const T *vals,
    std::size_t numel,
    int device_id,
    unsigned int block_size,
    MetaXArgmaxReduction reduction,
    MetaXArgmaxMerge merge,
    mcStream_t stream) {
    const unsigned int grid_size = get_metax_argmax_grid_size(numel, block_size);

    // --------------------------------------------------------
    // NVIDIA-structure-aligned experimental path:
    //
    //     Shuffle64 block reduction
    //     + one packed 64-bit atomicCAS merge per block
    //     + finalize kernel
    // --------------------------------------------------------

    if (merge == MetaXArgmaxMerge::ATOMIC) {
        CHECK_ARGUMENT(
            reduction == MetaXArgmaxReduction::SHUFFLE,
            "Argmax: MetaX atomic merge currently "
            "requires reduction=shuffle.");

        unsigned long long *packed_workspace = METAX_ARGMAX_ATOMIC_WORKSPACE.get(device_id);

        CHECK_ARGUMENT(
            packed_workspace != nullptr,
            "Argmax: MetaX packed atomic workspace "
            "must not be null.");

        return metax_detail::launch_argmax_multiblock_shuffle_atomic<T>(
            max_idx, max_val, vals, numel, packed_workspace, block_size, grid_size, stream);
    }

    // --------------------------------------------------------
    // Existing two-stage path.
    // --------------------------------------------------------

    ArgmaxResult *partial_results
        = METAX_ARGMAX_WORKSPACE.get(device_id, static_cast<std::size_t>(grid_size));

    CHECK_ARGUMENT(
        partial_results != nullptr,
        "Argmax: MetaX partial-result "
        "workspace must not be null.");

    if (reduction == MetaXArgmaxReduction::TREE) {
        return metax_detail::launch_argmax_multiblock_tree<T>(
            max_idx, max_val, vals, numel, partial_results, block_size, grid_size, stream);
    }

    if (reduction == MetaXArgmaxReduction::CUB) {
        return metax_detail::launch_argmax_multiblock_cub<T>(
            max_idx, max_val, vals, numel, partial_results, block_size, grid_size, stream);
    }

    return metax_detail::launch_argmax_multiblock_shuffle<T>(
        max_idx, max_val, vals, numel, partial_results, block_size, grid_size, stream);
}

// ============================================================
// Typed launcher
// ============================================================

template <typename T>
void launch_metax_argmax(
    std::int64_t *max_idx,
    T *max_val,
    const T *vals,
    std::size_t numel,
    int device_id,
    mcStream_t stream) {
    const unsigned int block_size = get_metax_argmax_block_size();

    const MetaXArgmaxImpl configured_impl = get_metax_argmax_impl();

    const MetaXArgmaxImpl selected_impl = select_metax_argmax_impl(configured_impl, numel);

    const MetaXArgmaxReduction reduction = get_metax_argmax_reduction();

    const MetaXArgmaxMerge merge = get_metax_argmax_merge();

    // --------------------------------------------------------
    // Debug output
    // --------------------------------------------------------

    if (metax_argmax_debug_enabled()) {
        const std::size_t threshold = get_metax_argmax_multiblock_threshold();

        if (selected_impl == MetaXArgmaxImpl::PORTABLE) {
            std::fprintf(
                stderr,
                "[MetaX Argmax] "
                "configured=%s "
                "selected=portable "
                "numel=%zu "
                "threshold=%zu "
                "block=%u "
                "reduction=n/a "
                "merge=n/a\n",
                metax_argmax_impl_name(configured_impl),
                numel,
                threshold,
                block_size);
        } else {
            const unsigned int grid_size = get_metax_argmax_grid_size(numel, block_size);

            std::fprintf(
                stderr,
                "[MetaX Argmax] "
                "configured=%s "
                "selected=multiblock "
                "numel=%zu "
                "threshold=%zu "
                "block=%u "
                "grid=%u "
                "reduction=%s "
                "merge=%s\n",
                metax_argmax_impl_name(configured_impl),
                numel,
                threshold,
                block_size,
                grid_size,
                metax_argmax_reduction_name(reduction),
                metax_argmax_merge_name(merge));
        }
    }

    // --------------------------------------------------------
    // Portable
    // --------------------------------------------------------

    if (selected_impl == MetaXArgmaxImpl::PORTABLE) {
        return launch_metax_argmax_portable<T>(max_idx, max_val, vals, numel, block_size, stream);
    }

    // --------------------------------------------------------
    // Multi-block Tree / CUB / Shuffle64
    // --------------------------------------------------------

    return launch_metax_argmax_multiblock<T>(
        max_idx, max_val, vals, numel, device_id, block_size, reduction, merge, stream);
}

} // namespace

// ============================================================
// Public MetaX backend
// ============================================================

namespace llaisys::ops::metax {

void argmax(
    std::byte *max_idx,
    std::byte *max_val,
    const std::byte *vals,
    llaisysDataType_t type,
    std::size_t numel,
    int device_id,
    llaisysStream_t stream) {
    CHECK_ARGUMENT(
        max_idx != nullptr,
        "Argmax: max_idx pointer "
        "must not be null.");

    CHECK_ARGUMENT(
        max_val != nullptr,
        "Argmax: max_val pointer "
        "must not be null.");

    CHECK_ARGUMENT(
        vals != nullptr,
        "Argmax: vals pointer "
        "must not be null.");

    CHECK_ARGUMENT(
        numel > 0,
        "Argmax: input tensor "
        "must not be empty.");

    CHECK_ARGUMENT(
        numel <= static_cast<std::size_t>(std::numeric_limits<std::uint32_t>::max()),
        "Argmax: MetaX implementation "
        "supports at most UINT32_MAX elements.");

    CHECK_ARGUMENT(
        device_id >= 0,
        "Argmax: MetaX device id "
        "must be non-negative.");

    const mcStream_t mc_stream = reinterpret_cast<mcStream_t>(stream);

    return dispatch_metax_dtype(type, [&](auto tag) {
        using T = typename decltype(tag)::type;

        return launch_metax_argmax<T>(
            reinterpret_cast<std::int64_t *>(max_idx),
            reinterpret_cast<T *>(max_val),
            reinterpret_cast<const T *>(vals),
            numel,
            device_id,
            mc_stream);
    });
}

} // namespace llaisys::ops::metax