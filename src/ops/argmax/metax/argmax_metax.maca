#include "argmax_metax.hpp"

#include "../../../device/metax/metax_common.hpp"
#include "../../../device/metax/metax_dtype.hpp"
#include "../../../utils.hpp"

#include "../cuda_compat/argmax_cuda_compat.cuh"
