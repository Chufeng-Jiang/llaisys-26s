#include "../../../device/metax/metax_common.hpp"
#include "../../../device/metax/metax_dtype.hpp"
#include "../../../utils.hpp"

#include "../cuda_compat/add_cuda_compat.cuh"
#include "add_metax.hpp"

#include <cstddef>

namespace {

namespace cuda_compat = llaisys::ops::cuda_compat;

using llaisys::device::metax::dispatch_metax_dtype;

template <typename T>
void launch_metax_add(T *c, const T *a, const T *b, std::size_t numel, mcStream_t stream) {
    if (numel == 0) { return; }

    // ========================================================
    // Select shared scalar/vectorized implementation
    // ========================================================

    const bool use_vectorized_kernel = cuda_compat::can_use_vectorized_add<T>(c, a, b, numel);

    // ========================================================
    // MetaX launch configuration
    // ========================================================

    constexpr std::size_t block_size = 256;

    const std::size_t work_items = cuda_compat::get_add_work_items<T>(numel, use_vectorized_kernel);

    const std::size_t grid_size = (work_items + block_size - 1) / block_size;

    // ========================================================
    // Shared CUDA-compatible kernel
    // ========================================================

    cuda_compat::launch_add_kernel<T>(
        c, a, b, numel, block_size, grid_size, use_vectorized_kernel, stream);

    // ========================================================
    // MetaX-specific launch error checking
    // ========================================================

    MC_CHECK(mcGetLastError());
}

} // namespace

namespace llaisys::ops::metax {

void add(
    std::byte *c,
    const std::byte *a,
    const std::byte *b,
    llaisysDataType_t type,
    std::size_t numel,
    llaisysStream_t stream) {
    CHECK_ARGUMENT(numel == 0 || c != nullptr, "Add: output pointer c must not be null.");

    CHECK_ARGUMENT(numel == 0 || a != nullptr, "Add: input pointer a must not be null.");

    CHECK_ARGUMENT(numel == 0 || b != nullptr, "Add: input pointer b must not be null.");

    const mcStream_t mc_stream = reinterpret_cast<mcStream_t>(stream);

    return dispatch_metax_dtype(type, [&](auto tag) {
        using T = typename decltype(tag)::type;

        return launch_metax_add<T>(
            reinterpret_cast<T *>(c),
            reinterpret_cast<const T *>(a),
            reinterpret_cast<const T *>(b),
            numel,
            mc_stream);
    });
}

} // namespace llaisys::ops::metax
