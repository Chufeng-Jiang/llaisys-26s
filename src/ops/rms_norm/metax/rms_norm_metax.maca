#include "../../../device/metax/metax_common.hpp"
#include "../../../device/metax/metax_dtype.hpp"
#include "../../../utils.hpp"

#include "../cuda_compat/rms_norm_cuda_compat.cuh"
#include "rms_norm_metax.hpp"

#include <cub/block/block_reduce.cuh>

#include <cmath>
#include <cstddef>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <limits>
#include <stdexcept>

namespace {

namespace cuda_compat = llaisys::ops::cuda_compat;

using llaisys::device::metax::dispatch_metax_dtype;

// ============================================================
// MetaX RMSNorm reduction implementation
// ============================================================

enum class MetaXRMSNormReduction {
    TREE,
    CUB,
};

// ============================================================
// Block-size experiment control
// ============================================================
//
// Environment:
//
//     LLAISYS_METAX_RMS_NORM_BLOCK_SIZE
//
// Supported:
//
//     64
//     128
//     256
//
// Default:
//
//     256
//
// ============================================================

unsigned int get_metax_rms_norm_block_size() {
    const char *value = std::getenv("LLAISYS_METAX_RMS_NORM_BLOCK_SIZE");

    if (value == nullptr) { return 256; }

    const int block_size = std::atoi(value);

    if (block_size != 64 && block_size != 128 && block_size != 256) {
        throw std::invalid_argument(
            "LLAISYS_METAX_RMS_NORM_BLOCK_SIZE "
            "must be 64, 128, or 256");
    }

    return static_cast<unsigned int>(block_size);
}

// ============================================================
// Reduction experiment control
// ============================================================
//
// Environment:
//
//     LLAISYS_METAX_RMS_NORM_REDUCTION
//
// Supported:
//
//     tree
//     cub
//
// Default:
//
//     tree
//
// ============================================================

MetaXRMSNormReduction get_metax_rms_norm_reduction() {
    const char *value = std::getenv("LLAISYS_METAX_RMS_NORM_REDUCTION");

    if (value == nullptr) { return MetaXRMSNormReduction::TREE; }

    if (std::strcmp(value, "tree") == 0) { return MetaXRMSNormReduction::TREE; }

    if (std::strcmp(value, "cub") == 0) { return MetaXRMSNormReduction::CUB; }

    throw std::invalid_argument(
        "LLAISYS_METAX_RMS_NORM_REDUCTION "
        "must be 'tree' or 'cub'");
}

const char *get_metax_rms_norm_reduction_name(MetaXRMSNormReduction reduction) {
    switch (reduction) {
    case MetaXRMSNormReduction::TREE:
        return "tree";

    case MetaXRMSNormReduction::CUB:
        return "cub";
    }

    return "unknown";
}

// ============================================================
// Scalar conversion helpers
// ============================================================
//
// Keep the CUB experimental implementation independent from
// vendor-specific half/bfloat vector intrinsics.
//
// FP16/BF16 input values are converted to FP32 before:
//
//     square
//     accumulation
//     normalization
//     weight multiplication
//
// ============================================================

template <typename T> __device__ __forceinline__ float metax_rms_norm_to_float(T value) {
    return static_cast<float>(value);
}

template <typename T> __device__ __forceinline__ T metax_rms_norm_from_float(float value) {
    return static_cast<T>(value);
}

// ============================================================
// CUB Packed128 representation
// ============================================================
//
// 128 bits = 16 bytes.
//
// Therefore:
//
//     FP32:
//         16 / 4 = 4 elements
//
//     FP16:
//         16 / 2 = 8 elements
//
//     BF16:
//         16 / 2 = 8 elements
//
// Eligibility itself remains controlled by the shared
// can_use_packed_rms_norm() contract.
//
// ============================================================

template <typename T> inline constexpr std::size_t CUB_PACKED_128_ELEMENTS = 16 / sizeof(T);

// ============================================================
// Packed128 load
// ============================================================

template <typename T> __device__ __forceinline__ uint4 load_cub_packed_128(const T *ptr) {
    return *reinterpret_cast<const uint4 *>(ptr);
}

// ============================================================
// Packed128 store
// ============================================================

template <typename T>
__device__ __forceinline__ void store_cub_packed_128(T *ptr, const uint4 &value) {
    *reinterpret_cast<uint4 *>(ptr) = value;
}

// ============================================================
// CUB RMSNorm kernel
// ============================================================
//
// This kernel supports:
//
//     CUB + Scalar
//
// and:
//
//     CUB + Packed128
//
// controlled by:
//
//     use_packed_kernel
//
// Reduction:
//
//     cub::BlockReduce<float, BLOCK_SIZE>
//
// Accumulation:
//
//     FP32
//
// Grid:
//
//     one block per row
//
// ============================================================

template <typename T, unsigned int BLOCK_SIZE>
__global__ void rms_norm_cub_kernel(
    T *out,
    const T *in,
    const T *weight,
    float eps,
    std::size_t nrow,
    std::size_t ncol,
    bool use_packed_kernel) {
    using BlockReduce = cub::BlockReduce<float, BLOCK_SIZE>;

    __shared__ typename BlockReduce::TempStorage temp_storage;

    __shared__ float inverse_rms;

    const std::size_t row = static_cast<std::size_t>(blockIdx.x);

    if (row >= nrow) { return; }

    const std::size_t row_offset = row * ncol;

    // ========================================================
    // Stage 1:
    // FP32 sum of squares
    // ========================================================

    float local_sum = 0.0F;

    if (use_packed_kernel) {
        // ----------------------------------------------------
        // Packed128 input traversal
        // ----------------------------------------------------

        constexpr std::size_t ELEMENTS_PER_PACK = CUB_PACKED_128_ELEMENTS<T>;

        const std::size_t packs_per_row = ncol / ELEMENTS_PER_PACK;

        const T *row_input = in + row_offset;

        for (std::size_t pack_index = static_cast<std::size_t>(threadIdx.x);
             pack_index < packs_per_row;
             pack_index += BLOCK_SIZE) {
            const std::size_t element_offset = pack_index * ELEMENTS_PER_PACK;

            const uint4 packed = load_cub_packed_128(row_input + element_offset);

            const T *values = reinterpret_cast<const T *>(&packed);

#pragma unroll
            for (std::size_t i = 0; i < ELEMENTS_PER_PACK; ++i) {
                const float value = metax_rms_norm_to_float(values[i]);

                local_sum = fmaf(value, value, local_sum);
            }
        }
    } else {
        // ----------------------------------------------------
        // Scalar input traversal
        // ----------------------------------------------------

        for (std::size_t col = static_cast<std::size_t>(threadIdx.x); col < ncol;
             col += BLOCK_SIZE) {
            const float value = metax_rms_norm_to_float(in[row_offset + col]);

            local_sum = fmaf(value, value, local_sum);
        }
    }

    // ========================================================
    // Stage 2:
    // CUB BlockReduce
    // ========================================================

    const float sum = BlockReduce(temp_storage).Sum(local_sum);

    if (threadIdx.x == 0) {
        const float mean = sum / static_cast<float>(ncol);

        inverse_rms = 1.0F / sqrtf(mean + eps);
    }

    __syncthreads();

    const float inv = inverse_rms;

    // ========================================================
    // Stage 3:
    // Normalize + weight
    // ========================================================
    //
    // All input reads used by the reduction have completed
    // before this point.
    //
    // Therefore:
    //
    //     out == in
    //
    // remains safe.
    // ========================================================

    if (use_packed_kernel) {
        // ----------------------------------------------------
        // Packed128 output traversal
        // ----------------------------------------------------

        constexpr std::size_t ELEMENTS_PER_PACK = CUB_PACKED_128_ELEMENTS<T>;

        const std::size_t packs_per_row = ncol / ELEMENTS_PER_PACK;

        const T *row_input = in + row_offset;

        T *row_output = out + row_offset;

        for (std::size_t pack_index = static_cast<std::size_t>(threadIdx.x);
             pack_index < packs_per_row;
             pack_index += BLOCK_SIZE) {
            const std::size_t element_offset = pack_index * ELEMENTS_PER_PACK;

            // -----------------------------------------------
            // Packed input
            // -----------------------------------------------

            const uint4 input_packed = load_cub_packed_128(row_input + element_offset);

            // -----------------------------------------------
            // Packed weight
            // -----------------------------------------------

            const uint4 weight_packed = load_cub_packed_128(weight + element_offset);

            const T *input_values = reinterpret_cast<const T *>(&input_packed);

            const T *weight_values = reinterpret_cast<const T *>(&weight_packed);

            // -----------------------------------------------
            // Build packed result
            // -----------------------------------------------

            uint4 output_packed;

            T *output_values = reinterpret_cast<T *>(&output_packed);

#pragma unroll
            for (std::size_t i = 0; i < ELEMENTS_PER_PACK; ++i) {
                const float input_value = metax_rms_norm_to_float(input_values[i]);

                const float weight_value = metax_rms_norm_to_float(weight_values[i]);

                const float normalized = input_value * inv;

                const float result = normalized * weight_value;

                output_values[i] = metax_rms_norm_from_float<T>(result);
            }

            store_cub_packed_128(row_output + element_offset, output_packed);
        }
    } else {
        // ----------------------------------------------------
        // Scalar output traversal
        // ----------------------------------------------------

        for (std::size_t col = static_cast<std::size_t>(threadIdx.x); col < ncol;
             col += BLOCK_SIZE) {
            const float input_value = metax_rms_norm_to_float(in[row_offset + col]);

            const float weight_value = metax_rms_norm_to_float(weight[col]);

            const float normalized = input_value * inv;

            const float result = normalized * weight_value;

            out[row_offset + col] = metax_rms_norm_from_float<T>(result);
        }
    }
}

// ============================================================
// Shared-tree RMSNorm dispatch
// ============================================================
//
// This path reuses the existing shared CUDA-compatible
// implementation.
//
// BLOCK_SIZE remains a compile-time template parameter.
//
// ============================================================

template <typename T>
void launch_tree_rms_norm(
    T *out,
    const T *in,
    const T *weight,
    float eps,
    std::size_t nrow,
    std::size_t ncol,
    std::size_t grid_size,
    bool use_packed_kernel,
    unsigned int block_size,
    mcStream_t stream) {
    switch (block_size) {
    case 64:
        cuda_compat::launch_rms_norm_kernel<T, 64>(
            out, in, weight, eps, nrow, ncol, grid_size, use_packed_kernel, stream);
        break;

    case 128:
        cuda_compat::launch_rms_norm_kernel<T, 128>(
            out, in, weight, eps, nrow, ncol, grid_size, use_packed_kernel, stream);
        break;

    case 256:
        cuda_compat::launch_rms_norm_kernel<T, 256>(
            out, in, weight, eps, nrow, ncol, grid_size, use_packed_kernel, stream);
        break;

    default:
        throw std::invalid_argument(
            "Unsupported MetaX RMSNorm "
            "tree block size.");
    }
}

// ============================================================
// CUB RMSNorm dispatch
// ============================================================

template <typename T>
void launch_cub_rms_norm(
    T *out,
    const T *in,
    const T *weight,
    float eps,
    std::size_t nrow,
    std::size_t ncol,
    std::size_t grid_size,
    bool use_packed_kernel,
    unsigned int block_size,
    mcStream_t stream) {
    const unsigned int grid = static_cast<unsigned int>(grid_size);

    switch (block_size) {
    case 64:
        rms_norm_cub_kernel<T, 64>
            <<<grid, 64, 0, stream>>>(out, in, weight, eps, nrow, ncol, use_packed_kernel);
        break;

    case 128:
        rms_norm_cub_kernel<T, 128>
            <<<grid, 128, 0, stream>>>(out, in, weight, eps, nrow, ncol, use_packed_kernel);
        break;

    case 256:
        rms_norm_cub_kernel<T, 256>
            <<<grid, 256, 0, stream>>>(out, in, weight, eps, nrow, ncol, use_packed_kernel);
        break;

    default:
        throw std::invalid_argument(
            "Unsupported MetaX RMSNorm "
            "CUB block size.");
    }
}

// ============================================================
// MetaX RMSNorm launch
// ============================================================

template <typename T>
void launch_metax_rms_norm(
    T *out,
    const T *in,
    const T *weight,
    float eps,
    std::size_t nrow,
    std::size_t ncol,
    mcStream_t stream) {
    // --------------------------------------------------------
    // Pointer validation
    // --------------------------------------------------------

    CHECK_ARGUMENT(
        nrow == 0 || out != nullptr,
        "RMSNorm: output pointer "
        "must not be null.");

    CHECK_ARGUMENT(
        nrow == 0 || in != nullptr,
        "RMSNorm: input pointer "
        "must not be null.");

    CHECK_ARGUMENT(
        nrow == 0 || weight != nullptr,
        "RMSNorm: weight pointer "
        "must not be null.");

    if (nrow == 0) { return; }

    // --------------------------------------------------------
    // Shape validation
    // --------------------------------------------------------

    CHECK_ARGUMENT(
        ncol > 0,
        "RMSNorm: row width must be "
        "greater than zero.");

    CHECK_ARGUMENT(
        ncol <= std::numeric_limits<std::size_t>::max() / nrow,
        "RMSNorm: tensor element count "
        "overflows size_t.");

    // --------------------------------------------------------
    // Epsilon validation
    // --------------------------------------------------------

    CHECK_ARGUMENT(
        std::isfinite(eps) && eps >= 0.0F,
        "RMSNorm: epsilon must be "
        "finite and nonnegative.");

    // --------------------------------------------------------
    // Grid validation
    // --------------------------------------------------------

    CHECK_ARGUMENT(
        nrow <= static_cast<std::size_t>(std::numeric_limits<unsigned int>::max()),
        "RMSNorm: MetaX grid size exceeds "
        "supported launch range.");

    // One block per row.
    const std::size_t grid_size = nrow;

    // ========================================================
    // Experimental policy controls
    // ========================================================

    const unsigned int block_size = get_metax_rms_norm_block_size();

    const MetaXRMSNormReduction reduction = get_metax_rms_norm_reduction();

    // ========================================================
    // Packed128 eligibility
    // ========================================================
    //
    // Reuse the same portable contract used by the shared
    // CUDA-compatible RMSNorm implementation.
    //
    // Requirements include:
    //
    //     complete 128-bit packs per row
    //     aligned out
    //     aligned in
    //     aligned weight
    //
    // ========================================================

    const bool packed_eligible = cuda_compat::can_use_packed_rms_norm<T>(out, in, weight, ncol);

    // ========================================================
    // Force-scalar experiment control
    // ========================================================

    const bool force_scalar = std::getenv("LLAISYS_METAX_RMS_NORM_FORCE_SCALAR") != nullptr;

    const bool use_packed_kernel = packed_eligible && !force_scalar;

    // ========================================================
    // Debug instrumentation
    // ========================================================

    if (std::getenv("LLAISYS_METAX_RMS_NORM_DEBUG") != nullptr) {
        std::fprintf(
            stderr,
            "[MetaX RMSNorm] "
            "nrow=%zu "
            "ncol=%zu "
            "block=%u "
            "reduction=%s "
            "eligible=%s "
            "force_scalar=%s "
            "packed=%s\n",
            nrow,
            ncol,
            block_size,
            get_metax_rms_norm_reduction_name(reduction),
            packed_eligible ? "true" : "false",
            force_scalar ? "true" : "false",
            use_packed_kernel ? "true" : "false");
    }

    // ========================================================
    // Reduction implementation dispatch
    // ========================================================

    switch (reduction) {
    case MetaXRMSNormReduction::TREE:
        launch_tree_rms_norm<T>(
            out, in, weight, eps, nrow, ncol, grid_size, use_packed_kernel, block_size, stream);
        break;

    case MetaXRMSNormReduction::CUB:
        launch_cub_rms_norm<T>(
            out, in, weight, eps, nrow, ncol, grid_size, use_packed_kernel, block_size, stream);
        break;
    }

    // ========================================================
    // Launch error check
    // ========================================================

    MC_CHECK(mcGetLastError());
}

} // namespace

// ============================================================
// Public MetaX RMSNorm entry point
// ============================================================

namespace llaisys::ops::metax {

void rms_norm(
    std::byte *out,
    const std::byte *in,
    const std::byte *weight,
    float eps,
    llaisysDataType_t type,
    std::size_t nrow,
    std::size_t ncol,
    llaisysStream_t stream) {
    const mcStream_t mc_stream = reinterpret_cast<mcStream_t>(stream);

    return dispatch_metax_dtype(type, [&](auto tag) {
        using T = typename decltype(tag)::type;

        return launch_metax_rms_norm<T>(
            reinterpret_cast<T *>(out),
            reinterpret_cast<const T *>(in),
            reinterpret_cast<const T *>(weight),
            eps,
            nrow,
            ncol,
            mc_stream);
    });
}

} // namespace llaisys::ops::metax